# ════════════════════════════════════════════════════════
# FitChef 环境变量配置
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
# ════════════════════════════════════════════════════════

# ── DeepSeek API（必填）───────────────────────────────
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Ollama Embedding（本地运行，必填）─────────────────
# 容器内用 host.docker.internal 访问宿主机 Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# ── MySQL（Docker 自动创建，无需修改）─────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=my_project1

# ── JWT（生产环境请更换 SECRET_KEY）───────────────────
SECRET_KEY=change-this-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Milvus 向量数据库（Docker 自动创建，无需修改）────
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=fitchef_knowledge

# ── LangFuse 可观测性（可选，不配则自动禁用）─────────
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=http://langfuse:3000
